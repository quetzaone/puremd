{
  "name": "puremd",
  "version": "1.1.0",
  "description": "Pure local Markdown viewer/editor for Windows",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/quetzaone/puremd.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "version": "node tools/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock installer/Cargo.toml installer/Cargo.lock",
    "tauri": "tauri",
    "build": "tsc && vite build",
    "build:installer": "node tools/build-installer.mjs",
    "check": "node tools/check-markdown-pipeline.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  },
  "overrides": {
    "lightningcss": "^1.33.0"
  }
}
